{
  "name": "sulitscan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test:recommendations && npm run test:seo && npm run test:compliance && npm run test:adsense && npm run test:checkout-comparison && npm run check:links && npm run check:affiliate-products && npm run check:product-quality && npm run build",
    "check:links": "node scripts/check-links.mjs",
    "check:affiliate-products": "node scripts/check-affiliate-products.mjs",
    "check:product-quality": "node scripts/check-product-quality.mjs",
    "test:recommendations": "node --test tests/recommendations.node.mjs",
    "test:seo": "node --test tests/seo-helpers.node.mjs",
    "test:compliance": "node --test tests/affiliate-compliance.node.mjs",
    "test:adsense": "node --test tests/adsense.node.mjs",
    "test:checkout-comparison": "node --test tests/checkout-comparison.node.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^1.3.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.22",
      "sharp": "0.35.3"
    }
  }
}
